# Copy to .env and fill in. Never commit .env.
# Scripts read this file directly (scripts/envfile.py); nothing needs exporting.

# --- LLMs ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Supabase ---
# Personal access token: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Filled in by scripts/supabase_setup.py when it creates the brightpan-demo project:
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- n8n (local, started by n8n/start.sh) ---
N8N_BASE_URL=http://localhost:5678
# Settings > n8n API > Create an API key
N8N_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/brightpan-chat
# Generated by n8n/deploy.py on first run; the chat proxy and eval send it as X-Brightpan-Key
N8N_WEBHOOK_SECRET=

# --- Shopify dev store (Dev Dashboard app with read_orders, write_orders) ---
# Store subdomain only, e.g. brightpan-demo (without .myshopify.com)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Escalations ---
# Slack incoming webhook: https://hooks.slack.com/services/...
SLACK_WEBHOOK_URL=
